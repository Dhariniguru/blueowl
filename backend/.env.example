# Copy this file to .env and fill in real values before running the app.

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-too-a-different-long-random-string

# Database
# For local dev, SQLite is used automatically if DATABASE_URL is not set.
# For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql://neolearn_user:password@localhost:5432/neolearn
DATABASE_URL=

# Optional: plug in a real cloud speech-to-text provider later.
# Until then, /api/voice/assess scores pronunciation by comparing the
# browser's Web Speech API transcript against the target text.
SPEECH_PROVIDER=browser

# AI Provider - Google Gemini (default)
# Get your API key at: https://aistudio.google.com/apikey
# Use model: gemini-2.5-flash (set in providers.py)
GEMINI_API_KEY=your-gemini-api-key-here

# AI Provider - OpenAI (fallback)
# OPENAI_API_KEY=your-openai-api-key-here
